{
  "name": "rolldown-plugin-raw-template",
  "version": "0.1.2",
  "description": "Import assets as template literals (template strings).",
  "keywords": [
    "plugin",
    "rolldown",
    "rolldown-plugin",
    "vite-plugin"
  ],
  "homepage": "https://github.com/JasonHK/rolldown-plugin-raw-template",
  "bugs": {
    "url": "https://github.com/JasonHK/rolldown-plugin-raw-template/issues"
  },
  "license": "MIT",
  "author": "Jason Kwok <hello@jasonhk.me> (https://jasonhk.me/)",
  "main": "./dist/index.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JasonHK/rolldown-plugin-raw-template.git"
  },
  "scripts": {
    "build": "tsdown",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:types": "tsc"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "rolldown": "^1.2.16",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "rolldown": "^1.0.0",
    "vite": ">=2.0.0 <9"
  },
  "peerDependenciesMeta": {
    "rolldown": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error",
      "version": "12.x"
    }
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts"
    }
  },
  "types": "./dist/index.d.mts"
}
